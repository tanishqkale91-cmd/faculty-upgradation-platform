# ─────────────────────────────────────────────────────
#  Environment Configuration — Frontend (React + Vite)
#  Copy this file to .env and fill in values.
#  All variables MUST be prefixed with VITE_ to be
#  accessible in the browser bundle.
# ─────────────────────────────────────────────────────

# Backend API base URL
# Development: leave blank to use the Vite proxy (see vite.config.js)
# Production: set to your deployed backend URL
VITE_API_BASE_URL=
