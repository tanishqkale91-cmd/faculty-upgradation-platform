# ─────────────────────────────────────────────
#  Environment Configuration — Backend
#  Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/faculty-platform?retryWrites=true&w=majority

# For local MongoDB use:
# MONGO_URI=mongodb://localhost:27017/faculty-platform

# JWT (used in Phase 2 — auth)
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

NODE_ENV=development
